---
// Page hero: dark band filled with the client's pattern, centred title, ornament and intro.
// Title and text come from the "pages" content collection (editable in /admin).
import Ornament from './Ornament.astro';
import { SITE } from '../lib/site.js';

interface Props {
  title: string;
  text: string;
  eyebrow?: string;
}

const { title, text, eyebrow = SITE.name } = Astro.props;
---

<header class="hero has-pattern has-pattern--fade">
  <div class="hero__inner">
    <p class="hero__eyebrow rise" style="--d: 0ms">{eyebrow}</p>
    <h1 class="hero__title rise" style="--d: 120ms">{title}</h1>
    <Ornament class="rise mx-auto mt-7 block text-[var(--color-accent-brown)]" style="--d: 260ms" />
    <p class="hero__text rise" style="--d: 380ms">{text}</p>
  </div>
</header>

<style>
  .hero {
    position: relative;
    z-index: 1;
    background-color: var(--color-hero-bg);
    color: var(--color-hero-ink);
    text-align: center;
    padding: clamp(3.5rem, 9vw, 7rem) 1.25rem clamp(3.25rem, 8vw, 6rem);
    /* Soft warm spotlight in the middle; the pattern overlay fades out toward the edges. */
    background-image: radial-gradient(ellipse 60% 70% at 50% 45%, var(--hero-glow), transparent 70%);
    border-bottom: 1px solid var(--color-accent-brown);
  }
  /* A diamond on the bottom edge, where the dark band meets the page. */
  .hero::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.55rem;
    width: 1.1rem;
    height: 1.1rem;
    transform: translateX(-50%) rotate(45deg);
    background: var(--color-surface);
    border: 1px solid var(--color-accent-brown);
  }
  .hero__inner {
    max-width: 46rem;
    margin-inline: auto;
  }
  .hero__eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-hero-eyebrow);
  }
  .hero__title {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .hero__text {
    max-width: 36rem;
    margin: 1.5rem auto 0;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-hero-text);
    text-wrap: pretty;
  }
</style>
