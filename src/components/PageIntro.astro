---
// Title block at the top of a content page. Text comes from the "pages" content collection (editable in /admin).
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<header class="mx-auto max-w-6xl px-4 pt-10 pb-8 sm:px-6 sm:pt-16 sm:pb-12">
  <h1 class="font-serif text-3xl sm:text-5xl">{title}</h1>
  <p class="mt-3 max-w-prose text-base sm:mt-4 sm:text-lg">{text}</p>
</header>
