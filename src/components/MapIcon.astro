---
// Small line icons for map landmarks. Decorative: the label next to each icon carries the meaning.
interface Props {
  name:
    | 'charminar'
    | 'palace'
    | 'fort'
    | 'buddha'
    | 'temple'
    | 'bridge'
    | 'park'
    | 'lake'
    | 'industry'
    | 'school'
    | 'hospital'
    | 'restaurant'
    | 'office';
}

const { name } = Astro.props;
---

<svg
  class="map-icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'charminar' && (
      <>
        <path d="M3 21h18" />
        <path d="M5 21V9M19 21V9M8 21V12M16 21V12" />
        <circle cx="5" cy="7.5" r="1.5" />
        <circle cx="19" cy="7.5" r="1.5" />
        <path d="M5 12h14" />
        <path d="M9.5 21v-5a2.5 2.5 0 0 1 5 0v5" />
      </>
    )
  }
  {
    name === 'palace' && (
      <>
        <path d="M3 21h18M5 21V13h14v8" />
        <path d="M8.5 13V10a3.5 3.5 0 0 1 7 0v3" />
        <path d="M12 6.5V4" />
        <path d="M10.5 21v-4h3v4" />
      </>
    )
  }
  {
    name === 'fort' && (
      <>
        <path d="M3 21V10h3V7h3v3h6V7h3v3h3v11Z" />
        <path d="M10 21v-5a2 2 0 0 1 4 0v5" />
      </>
    )
  }
  {
    name === 'buddha' && (
      <>
        <circle cx="12" cy="6" r="2.5" />
        <path d="M5.5 17 12 10l6.5 7Z" />
        <path d="M2.5 21c2-1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0" />
      </>
    )
  }
  {
    name === 'temple' && (
      <>
        <path d="M12 3v2M8 12l4-7 4 7" />
        <path d="M6 21v-9h12v9M3 21h18" />
        <path d="M10.5 21v-4h3v4" />
      </>
    )
  }
  {
    name === 'bridge' && (
      <>
        <path d="M2 19h20M12 4v15" />
        <path d="M12 6 3 19M12 6l9 13M12 10l-5 9M12 10l5 9" />
      </>
    )
  }
  {
    name === 'park' && (
      <>
        <circle cx="12" cy="9" r="5.5" />
        <path d="M12 14.5V21M8.5 21h7" />
      </>
    )
  }
  {
    name === 'lake' && (
      <>
        <path d="M3 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
        <path d="M3 14c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
        <path d="M3 19c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
      </>
    )
  }
  {
    name === 'school' && (
      <>
        <path d="M2 9l10-5 10 5-10 5z" />
        <path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" />
        <path d="M22 9v6" />
      </>
    )
  }
  {
    name === 'hospital' && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="3" />
        <path d="M12 8v8M8 12h8" />
      </>
    )
  }
  {
    name === 'restaurant' && (
      <>
        <path d="M7 3v7a2 2 0 0 0 2 2v9M7 3v5M11 3v5M9 3v9" />
        <path d="M17 3c-2 2-2.5 5-2.5 8h2.5v10" />
      </>
    )
  }
  {
    name === 'office' && (
      <>
        <path d="M5 21V4h9v17M14 9h5v12M3 21h18" />
        <path d="M8 8h3M8 12h3M8 16h3" />
      </>
    )
  }
  {
    name === 'industry' && (
      <>
        <path d="M3 21h18" />
        <path d="M4 21V11l5 3v-3l5 3V6h4v15" />
        <path d="M8 17h2M13 17h2" />
      </>
    )
  }
</svg>
