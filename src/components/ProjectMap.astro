---
// Full-width Hyderabad map: one pin per published project plus decorative areas and landmarks.
// Server-rendered, no JS needed for pins. On narrow screens the map keeps a readable size and scrolls sideways.
import type { CollectionEntry } from 'astro:content';
import mapSvg from '../assets/hyderabad-map.svg?raw';
import { getImage } from 'astro:assets';
import MapIcon from './MapIcon.astro';
import ProjectCollage from './ProjectCollage.astro';
import { getProjectPhotos } from '../lib/projectPhotos';
import { MAP_WIDTH, MAP_HEIGHT, toPercent } from '../lib/mapProjection.js';
import { areas, landmarks } from '../lib/hyderabadPlaces.js';
import { CONTACT, SITE } from '../lib/site.js';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const pins = await Promise.all(
  projects.map(async (p) => ({
    id: p.id,
    title: p.data.title,
    place: p.data.area ? `${p.data.area}, ${p.data.location}` : p.data.location,
    thumb: p.data.cover
      ? await getImage({
          src: p.data.cover,
          width: 480,
          height: 300,
          fit: 'cover',
        })
      : undefined,
    photos: await getProjectPhotos(p),
    ...toPercent(p.data.coordinates.lat, p.data.coordinates.lng),
  })),
);

const office = toPercent(CONTACT.coordinates.lat, CONTACT.coordinates.lng);

// Only draw labels inside the visible map window (zoomed on west Hyderabad to Hitech City).
const inView = (p: { left: number; top: number }) =>
  p.left > 4 && p.left < 92 && p.top > 5 && p.top < 92;
const areaLabels = areas
  .map((a) => ({ ...a, ...toPercent(a.lat, a.lng) }))
  .filter(inView);
const landmarkLabels = landmarks
  .map((l) => ({ ...l, ...toPercent(l.lat, l.lng) }))
  .filter(inView);
---

<figure class="project-map">
  <div
    class="project-map__scroller"
    role="region"
    aria-label="Map of Hyderabad with our project locations. Scroll sideways to explore."
    tabindex="0"
  >
    <div
      class="project-map__canvas"
      style={`aspect-ratio:${MAP_WIDTH}/${MAP_HEIGHT}`}
    >
      <Fragment set:html={mapSvg} />

      {
        areaLabels.map((a) => (
          <span
            class={`place place--area ${a.size === 'lg' ? 'place--lg' : ''}`}
            style={`left:${a.left}%;top:${a.top}%;--dx:${a.dx ?? 0}em;--dy:${a.dy ?? 0}em`}
            aria-hidden="true"
          >
            {a.name}
          </span>
        ))
      }

      {
        landmarkLabels.map((l) => (
          <span
            class={`place place--landmark place--${l.place}`}
            style={`left:${l.left}%;top:${l.top}%`}
            aria-hidden="true"
          >
            <MapIcon name={l.icon} />
            <span class="place__name">{l.name}</span>
          </span>
        ))
      }

      <a
        class="office-pin"
        href={CONTACT.mapUrl}
        target="_blank"
        rel="noopener"
        style={`left:${office.left}%;top:${office.top}%`}
        aria-label={`${SITE.name} office, ${CONTACT.address}. Opens directions in a new tab.`}
      >
        <span class="office-pin__badge" aria-hidden="true"
          ><MapIcon name="office" /></span
        >
        <span class="office-pin__label" aria-hidden="true"
          >Nest Weavers Office</span
        >
      </a>

      {
        pins.map((pin) => (
          <a
            class="project-map__pin"
            href={`/projects/${pin.id}/`}
            data-collage={pin.id}
            style={`left:${pin.left}%;top:${pin.top}%`}
            aria-label={`${pin.title}, ${pin.place}. Opens photos.`}
          >
            <span class="project-map__dot" aria-hidden="true" />
            <span class="project-map__card" aria-hidden="true">
              {pin.thumb && (
                <img
                  src={pin.thumb.src}
                  width={pin.thumb.attributes.width}
                  height={pin.thumb.attributes.height}
                  alt=""
                />
              )}
              <strong>{pin.title}</strong>
              <span>{pin.place}</span>
              <span class="project-map__cta">Click to view photos</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
  <figcaption class="project-map__foot">
    <span class="project-map__hint">Drag sideways to explore the city</span>
    <span>
      Map data © <a
        href="https://www.openstreetmap.org/copyright"
        rel="noopener">OpenStreetMap</a
      > contributors
    </span>
  </figcaption>
</figure>

{
  pins.map((pin) => (
    <dialog
      id={`collage-${pin.id}`}
      class="collage-dialog"
      aria-label={`${pin.title} photos`}
    >
      <header class="collage-dialog__head">
        <div>
          <h2>{pin.title}</h2>
          <p>{pin.place}</p>
        </div>
        <a href={`/projects/${pin.id}/`} class="collage-dialog__link">
          View project page →
        </a>
        <form method="dialog">
          <button class="collage-dialog__close" aria-label="Close photos">
            ×
          </button>
        </form>
      </header>
      <ProjectCollage photos={pin.photos} />
    </dialog>
  ))
}

<script>
  // Clicking a pin (or any [data-collage] link) opens that project's photo collage; without JS it follows the link.
  document.querySelectorAll<HTMLElement>('[data-collage]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const dialog = document.getElementById(
        `collage-${el.dataset.collage}`,
      ) as HTMLDialogElement | null;
      if (!dialog) return;
      e.preventDefault();
      dialog.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.collage-dialog').forEach((d) =>
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    }),
  );

  // On narrow screens the map scrolls sideways: start centred on the projects (or the city if there are none).
  document
    .querySelectorAll<HTMLElement>('.project-map__scroller')
    .forEach((el) => {
      const pins = Array.from(
        el.querySelectorAll<HTMLElement>('.project-map__pin'),
      );
      const target = pins.length
        ? pins.reduce((sum, pin) => sum + pin.offsetLeft, 0) / pins.length
        : el.scrollWidth / 2;
      el.scrollLeft = Math.max(0, target - el.clientWidth / 2);
    });
</script>

<style>
  .project-map {
    margin: 0;
  }
  /* Full-bleed: the parent places this outside the page's max-width container. */
  .project-map__scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    background: var(--color-map-land);
  }
  .project-map__scroller:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }
  .project-map__canvas {
    position: relative;
    /* Never narrower than a size at which labels stay readable; wider screens simply scale up. */
    width: max(100%, 1200px);
    container-type: inline-size;
    overflow: hidden; /* labels near an edge never create extra scroll */
  }
  .project-map__canvas :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Labels: sized from the canvas width so they scale with the map. */
  .place {
    position: absolute;
    pointer-events: none;
    color: var(--color-ink-muted);
    white-space: nowrap;
    line-height: 1;
  }
  .place--area {
    transform: translate(
      calc(-50% + var(--dx, 0em)),
      calc(-50% + var(--dy, 0em))
    );
    font-size: clamp(10px, 0.8cqw, 14px);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .place--lg {
    font-size: clamp(12px, 1.5cqw, 24px);
    letter-spacing: 0.2em;
    color: var(--color-accent-text);
    opacity: 1;
  }
  .place--landmark {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: clamp(11px, 1.05cqw, 17px);
    color: var(--color-ink);
  }
  .place--landmark :global(.map-icon) {
    flex: none;
    width: clamp(18px, 2cqw, 30px);
    height: auto;
    color: var(--color-accent-text);
    background: var(--color-map-land);
    border-radius: 50%;
  }
  .place--right {
    transform: translate(-0.9em, -50%);
  }
  .place--left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 0.9em), -50%);
  }
  .place--above {
    flex-direction: column-reverse;
    transform: translate(-50%, -100%);
  }
  .place--below {
    flex-direction: column;
    transform: translate(-50%, 0);
  }

  /* Pins: 44px tap target, smaller visible dot. */
  .project-map__pin {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    transform: translate(-50%, -50%);
  }
  .project-map__dot {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--color-pin-core) 0 26%,
      var(--color-pin) 28%
    );
    border: 3px solid var(--color-pin-ring);
    box-shadow:
      0 0 0 2px var(--color-pin-outline),
      0 4px 12px rgb(0 0 0 / 0.45);
    transition: transform 0.2s;
  }
  @media (prefers-reduced-motion: no-preference) {
    .project-map__dot::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      border: 2px solid var(--color-pin);
      animation: pin-pulse 2.4s ease-out infinite;
    }
    @keyframes pin-pulse {
      from {
        transform: scale(1);
        opacity: 0.8;
      }
      to {
        transform: scale(2.3);
        opacity: 0;
      }
    }
  }
  .project-map__pin:hover,
  .project-map__pin:focus-visible {
    z-index: 5; /* hovered pin and its card sit above neighbouring pins */
  }
  .project-map__pin:hover .project-map__dot,
  .project-map__pin:focus-visible .project-map__dot {
    transform: scale(1.2);
  }
  .project-map__pin:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -2px;
    border-radius: 50%;
  }
  /* The studio itself: a dark square badge with a building, always labelled, so it never reads as a project. */
  .office-pin {
    position: absolute;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    transform: translate(-50%, -50%);
    text-decoration: none;
  }
  .office-pin__badge {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 0.6rem;
    background: var(--color-ink);
    color: var(--color-surface);
    border: 3px solid var(--color-surface);
    box-shadow:
      0 0 0 2px var(--color-ink),
      0 4px 12px rgb(0 0 0 / 0.4);
    transition: transform 0.2s;
  }
  .office-pin__badge :global(.map-icon) {
    width: 22px;
    height: 22px;
    background: none;
    color: inherit;
  }
  .office-pin__label {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-surface);
    font-size: clamp(10px, 0.85cqw, 14px);
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .office-pin:hover .office-pin__badge,
  .office-pin:focus-visible .office-pin__badge {
    transform: scale(1.12);
  }
  .office-pin:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: 0.6rem;
  }
  .project-map__card {
    position: absolute;
    bottom: calc(100% - 4px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 12rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-card);
    color: var(--color-ink);
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.18);
    display: none;
    font-size: 0.875rem;
    text-align: left;
    white-space: nowrap;
    gap: 0.15rem;
  }
  .project-map__card img {
    width: 14rem;
    max-width: 60vw;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border-radius: 0.375rem;
    margin-bottom: 0.4rem;
  }
  .project-map__cta {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-accent-brown);
  }
  .collage-dialog {
    margin: auto;
    width: min(1100px, 94vw);
    max-width: none;
    max-height: 92vh;
    padding: 1.25rem;
    border: 0;
    border-radius: 1rem;
    background: var(--color-card);
    color: var(--color-ink);
  }
  .collage-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
  }
  .collage-dialog__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .collage-dialog__head > div {
    flex: 1;
  }
  .collage-dialog__head h2 {
    font-size: 1.5rem;
  }
  .collage-dialog__head p {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
  .collage-dialog__link {
    font-size: 0.875rem;
    text-decoration: underline;
  }
  .collage-dialog__close {
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    background: var(--color-map-land);
    color: var(--color-ink);
  }
  .collage-dialog button:focus-visible,
  .collage-dialog a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .project-map__pin:hover .project-map__card,
  .project-map__pin:focus-visible .project-map__card {
    display: grid;
  }

  .project-map__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem 0;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .project-map__foot a {
    color: inherit;
  }
  /* The scroll hint only matters when the map is wider than the screen. */
  @media (min-width: 1200px) {
    .project-map__hint {
      display: none;
    }
    .project-map__foot {
      justify-content: flex-end;
    }
  }
</style>
