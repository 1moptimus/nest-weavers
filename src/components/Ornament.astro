---
// Decorative divider: two hairlines around a small isometric cube, echoing the client's pattern.
// Colour comes from the parent (currentColor); purely decorative, so hidden from assistive tech.
interface Props {
  class?: string;
  style?: string;
}

const { class: className = '', style } = Astro.props;
---

<svg
  class={className}
  style={style}
  viewBox="0 0 132 16"
  width="132"
  height="16"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M2 8h50" />
  <path d="M80 8h50" />
  <!-- cube: hexagon plus three spokes from the centre -->
  <path d="M66 1.5l6.06 3.5v7L66 15.5l-6.06-3.5V5z" />
  <path d="M66 8.5L59.94 5M66 8.5L72.06 5M66 8.5v7" />
</svg>
