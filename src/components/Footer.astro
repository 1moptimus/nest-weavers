---
import SocialIcon from './SocialIcon.astro';
import { NAV, SOCIAL, SITE, CONTACT } from '../lib/site.js';

const year = new Date().getFullYear();
---

<footer class="site-footer has-pattern">
  <div class="site-footer__grid">
    <div>
      <p class="site-footer__brand">{SITE.name}</p>
      <p class="site-footer__tagline">{SITE.tagline}</p>
      <ul class="site-footer__social">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.href} rel="noopener" target="_blank" aria-label={`${s.name} (opens in a new tab)`}>
                <SocialIcon name={s.icon} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2>Contact</h2>
      <address>
        <p>{CONTACT.address}</p>
        {CONTACT.phones.map((n) => <p><a href={`tel:${n.replace(/[^+\d]/g, '')}`}>{n}</a></p>)}
        <p>{CONTACT.email}</p>
        <p>{CONTACT.hours}</p>
      </address>
    </div>
  </div>
  <p class="site-footer__legal">© {year} {SITE.name}. All rights reserved.</p>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding: 3.5rem 0 1.5rem;
    border-top: 1px solid var(--color-accent-brown);
    background-color: var(--color-footer-bg);
    color: var(--color-footer-ink);
    --pattern-opacity: var(--pattern-opacity-footer);
  }
  .site-footer__grid {
    display: grid;
    gap: 2rem;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  .site-footer__brand {
    font-family: var(--font-serif);
    font-size: 1.75rem;
  }
  .site-footer__tagline {
    margin-top: 0.25rem;
    color: var(--color-footer-muted);
    font-style: italic;
  }
  .site-footer h2 {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-footer-heading);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer nav a {
    display: inline-block;
    padding-block: 0.375rem;
    color: inherit;
    text-decoration: none;
  }
  .site-footer nav a:hover,
  address a:hover {
    color: var(--color-footer-heading);
    text-decoration: underline;
  }
  address a {
    color: inherit;
  }
  address {
    font-style: normal;
    display: grid;
    gap: 0.375rem;
  }
  .site-footer__social {
    display: flex;
    gap: 0.25rem;
    margin-top: 1rem;
  }
  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: inherit;
  }
  .site-footer__social a:hover {
    color: var(--color-footer-heading);
    background: var(--color-footer-line);
  }
  .site-footer a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .site-footer__legal {
    max-width: 72rem;
    margin: 2.5rem auto 0;
    padding: 1rem 1rem 0;
    border-top: 1px solid var(--color-footer-line);
    font-size: 0.8125rem;
    color: var(--color-footer-muted);
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1.5fr;
      padding-inline: 1.5rem;
    }
    .site-footer__legal {
      padding-inline: 1.5rem;
    }
  }
</style>
