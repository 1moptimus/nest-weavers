---
// Centred section heading with the cube ornament and an optional intro line.
import Ornament from './Ornament.astro';

interface Props {
  /** id of the h2, used by the parent section's aria-labelledby. */
  id: string;
  title: string;
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

<div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
  <h2 id={id} class="font-serif text-[clamp(1.75rem,4vw,2.75rem)] leading-tight text-balance">
    {title}
  </h2>
  <Ornament class="mx-auto mt-4 block text-[var(--color-accent-brown)]" />
  {intro && <p class="mx-auto mt-5 max-w-prose text-pretty leading-relaxed">{intro}</p>}
</div>
