---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import logoNegative from '../assets/brand/logo-negative.png';
import SocialIcon from './SocialIcon.astro';
import { NAV, SOCIAL } from '../lib/site.js';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;
---

<a href="#main" class="skip-link">Skip to content</a>

<header class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__logo">
      <Image
        class="logo--light"
        src={logo}
        width={104}
        densities={[1, 2]}
        format="webp"
        alt="Nest Weavers Interiors"
        loading="eager"
      />
      <Image
        class="logo--dark"
        src={logoNegative}
        width={104}
        densities={[1, 2]}
        format="webp"
        alt="Nest Weavers Interiors"
        loading="eager"
      />
    </a>

    <nav aria-label="Main" class="site-header__nav">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="site-header__social">
      {
        SOCIAL.map((s) => (
          <li>
            <a
              href={s.href}
              rel="noopener"
              target="_blank"
              aria-label={`${s.name} (opens in a new tab)`}
            >
              <SocialIcon name={s.icon} />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="site-header__tools">
      <button
        type="button"
        id="theme-toggle"
        class="site-header__icon-btn"
        aria-pressed="false"
      >
        <span class="sr-only">Dark mode</span>
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
        </svg>
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
          ></path>
        </svg>
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="site-header__icon-btn site-header__toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Menu</span>
        <span class="site-header__burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="mobile-menu__social">
      {
        SOCIAL.map((s) => (
          <li>
            <a
              href={s.href}
              rel="noopener"
              target="_blank"
              aria-label={`${s.name} (opens in a new tab)`}
            >
              <SocialIcon name={s.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById(
    'menu-toggle',
  ) as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');

  // While the menu is open the page behind it is inert, so Tab and screen readers stay inside the menu.
  const behind = () => document.querySelectorAll<HTMLElement>('main, footer');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    behind().forEach((el) => (el.inert = open));
  }

  toggle?.addEventListener('click', () =>
    setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
  );
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });
  // Light/dark toggle: the initial theme is set before paint (see BaseLayout); this only handles changes.
  const themeBtn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const syncTheme = () =>
    themeBtn?.setAttribute(
      'aria-pressed',
      String(root.dataset.theme === 'dark'),
    );
  syncTheme();
  themeBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncTheme();
  });
  // Follow the device setting while the visitor has not chosen a theme themselves.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    try {
      if (localStorage.getItem('theme')) return;
    } catch {}
    root.dataset.theme = e.matches ? 'dark' : 'light';
    syncTheme();
  });

  // Desktop layout has no menu button, so close the panel if the window grows past the breakpoint.
  matchMedia('(min-width: 768px)').addEventListener(
    'change',
    (e) => e.matches && setOpen(false),
  );
</script>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--color-ink);
    color: var(--color-surface);
    border-radius: 0.25rem;
  }
  .skip-link:focus {
    top: 0.75rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 72rem;
    height: 4.5rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  .site-header__logo {
    display: block;
    flex: none;
  }
  .site-header__logo :global(img) {
    display: block;
    height: auto;
  }
  /* Positive logo on light backgrounds, negative (white wordmark, blue bird) on dark. */
  .site-header__logo :global(.logo--dark) {
    display: none;
  }
  :global(:root[data-theme='dark']) .site-header__logo :global(.logo--light) {
    display: none;
  }
  :global(:root[data-theme='dark']) .site-header__logo :global(.logo--dark) {
    display: block;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Desktop navigation */
  .site-header__nav,
  .site-header__social {
    display: none;
  }
  .site-header__nav ul {
    display: flex;
    gap: 2rem;
  }
  .site-header__nav a,
  .mobile-menu nav a {
    display: inline-block;
    padding-block: 0.5rem;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .site-header__nav a:hover,
  .mobile-menu nav a:hover {
    border-bottom-color: var(--color-accent-sky);
  }
  .site-header__nav a[aria-current='page'],
  .mobile-menu nav a[aria-current='page'] {
    border-bottom-color: var(--color-accent-text);
    color: var(--color-accent-text);
  }
  .site-header__social {
    gap: 0.25rem;
  }
  .site-header__social a,
  .mobile-menu__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-ink);
    border-radius: 50%;
  }
  .site-header__social a:hover,
  .mobile-menu__social a:hover {
    color: var(--color-accent-text);
    background: rgb(146 109 82 / 0.1);
  }
  :is(.site-header a, .site-header button):focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .site-header__tools {
    display: flex;
    gap: 0.25rem;
  }
  /* Theme toggle and menu button: 44px targets. Moon is shown in light mode, sun in dark mode. */
  .site-header__icon-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 0;
    color: var(--color-ink);
    border-radius: 50%;
  }
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.5rem;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }
  .site-header__burger {
    position: relative;
  }
  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .site-header__burger::before {
    top: -7px;
  }
  .site-header__burger::after {
    top: 7px;
  }
  .site-header__toggle[aria-expanded='true'] .site-header__burger {
    background: transparent;
  }
  .site-header__toggle[aria-expanded='true'] .site-header__burger::before {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__burger::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile panel fills the screen under the header */
  .mobile-menu {
    position: absolute;
    inset: 4.5rem 0 auto 0;
    height: calc(100dvh - 4.5rem);
    padding: 2rem 1.5rem;
    background: var(--color-surface);
    overflow-y: auto;
  }
  .mobile-menu nav li {
    border-bottom: 1px solid var(--color-line);
  }
  .mobile-menu nav a {
    display: block;
    padding-block: 1rem;
    font-size: 1.125rem;
    border-bottom: 0;
  }
  .mobile-menu__social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .site-header__bar {
      padding-inline: 1.5rem;
    }
    .site-header__nav,
    .site-header__social {
      display: flex;
    }
    .site-header__toggle,
    .mobile-menu {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__burger,
    .site-header__burger::before,
    .site-header__burger::after {
      transition: none;
    }
  }
</style>
