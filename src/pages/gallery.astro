---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';

const page = await getEntry('pages', 'gallery');
if (!page) throw new Error('Missing "gallery" entry in src/content/pages/pages.json');
const { heroTitle, heroText } = page.data;

// PLACEHOLDER tiles: once the client uploads project photos, build this grid from the projects collection.
const tiles = Array.from({ length: 6 }, (_, i) => `Placeholder photo ${i + 1}`);
---

<BaseLayout title={heroTitle} description={heroText}>
  <PageIntro title={heroTitle} text={heroText} />
  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-label="Project photos">
    <ul class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {tiles.map((label) => <li><PlaceholderImage label={label} /></li>)}
    </ul>
  </section>
</BaseLayout>
