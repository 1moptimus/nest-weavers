---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectMap from '../components/ProjectMap.astro';
import { SITE } from '../lib/site.js';

// Editable copy lives in src/content/pages/pages.json (edited via /admin).
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing "home" entry in src/content/pages/pages.json');
const { heroTitle, heroText } = home.data;

// Drafts stay hidden from the site and the map.
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={SITE.name} description={heroText}>
  <header class="mx-auto max-w-6xl px-4 pt-8 pb-6 sm:px-6 sm:pt-12 sm:pb-8">
    <h1 class="font-serif text-3xl sm:text-5xl">{heroTitle}</h1>
    <p class="mt-3 max-w-prose text-base sm:mt-4 sm:text-lg">{heroText}</p>
  </header>

  <!-- Full-bleed: outside the max-width container so the map runs edge to edge. -->
  <section aria-labelledby="map-heading">
    <h2 id="map-heading" class="mx-auto mb-4 max-w-6xl px-4 text-xl sm:mb-6 sm:px-6 sm:text-2xl">
      Our projects in Hyderabad
    </h2>
    <ProjectMap projects={projects} />
  </section>

  {
    projects.length > 0 && (
      <section aria-labelledby="list-heading" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <h2 id="list-heading" class="mb-6 text-xl sm:text-2xl">
          All projects
        </h2>
        <ul class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
          {projects.map((p) => (
            <li id={p.id} class="scroll-mt-24 rounded-lg bg-white p-5 shadow-sm sm:p-6">
              <h3 class="text-lg sm:text-xl">{p.data.title}</h3>
              <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
                {p.data.area ? `${p.data.area}, ` : ''}
                {p.data.location} · {p.data.year} · {p.data.category}
              </p>
              <p class="mt-3">{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
