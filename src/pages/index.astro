---
import '../styles.css';
import { getCollection, getEntry } from 'astro:content';
import ProjectMap from '../components/ProjectMap.astro';

// Editable copy lives in src/content/pages/pages.json (edited via /admin).
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing "home" entry in src/content/pages/pages.json');
const { heroTitle, heroText } = home.data;

// Drafts stay hidden from the site and the map.
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nest Weavers</title>
    <meta name="description" content={heroText} />
  </head>
  <body>
    <main class="mx-auto max-w-6xl px-4 py-12">
      <header class="mb-10">
        <h1 class="font-serif text-4xl">{heroTitle}</h1>
        <p class="mt-4 max-w-prose">{heroText}</p>
      </header>

      <section aria-labelledby="map-heading" class="mb-16">
        <h2 id="map-heading" class="mb-6 text-2xl">Our projects in Hyderabad</h2>
        {projects.length > 0 ? (
          <ProjectMap projects={projects} />
        ) : (
          <p>Projects will appear here soon.</p>
        )}
      </section>

      <section aria-labelledby="list-heading">
        <h2 id="list-heading" class="mb-6 text-2xl">All projects</h2>
        <ul class="grid gap-6 sm:grid-cols-2">
          {
            projects.map((p) => (
              <li id={p.id} class="scroll-mt-8 rounded-lg bg-white p-6 shadow-sm">
                <h3 class="text-xl">{p.data.title}</h3>
                <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
                  {p.data.area ? `${p.data.area}, ` : ''}
                  {p.data.location} · {p.data.year} · {p.data.category}
                </p>
                <p class="mt-3">{p.data.summary}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
