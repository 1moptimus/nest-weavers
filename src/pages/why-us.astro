---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageSections from '../components/PageSections.astro';

const page = await getEntry('pages', 'why-us');
if (!page) throw new Error('Missing "why-us" entry in src/content/pages/pages.json');
const { heroTitle, heroText, sections } = page.data;
---

<BaseLayout title={heroTitle} description={heroText}>
  <PageHero title={heroTitle} text={heroText} />
  <PageSections sections={sections} />
</BaseLayout>
